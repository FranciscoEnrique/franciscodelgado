---
// franciscodelgado.dev — landing de una sola página.
// Contenido y enlaces editables desde estas constantes.

const contact = {
  email: "enriquedelgadoelizondo@gmail.com",
  // Quítalo si no quieres el teléfono público:
  tel: "+52 81 2936 1064",
  // Cambia por tu perfil real:
  linkedin: "https://www.linkedin.com/in/francisco-delgado",
  // Coloca el PDF en public/ con este nombre (o ajusta la ruta):
  cv: "/FranciscoDelgado_CV.pdf",
};

type Job = { role: string; org: string; dates?: string; body: string };

const experience: Job[] = [
  {
    role: "Programador Full Stack Jr.",
    org: "Fiscalía General de Justicia de Nuevo León",
    dates: "feb 2026 – hoy",
    body: "Aplicaciones internas en C#, .NET y SQL Server. Plataforma de gestión de proyectos, evidencias y control de calidad, con notificaciones en tiempo real (SignalR). Diseño y optimización de procedimientos y consultas SQL; pruebas y liberaciones.",
  },
  {
    role: "Analista Programador (práctica profesional)",
    org: "Panasonic Energy México",
    dates: "abr 2024 – ene 2026",
    body: "Digitalización y automatización de procesos para Recursos Humanos, Calidad, Producción, Finanzas y Laboratorio Eléctrico. Bases de datos en SQL Server, aplicaciones en .NET, automatización con Power Apps y Power Automate, y documentación técnica (BPMN, diccionarios de datos, casos de prueba).",
  },
  {
    role: "Auxiliar Administrativo de Calidad",
    org: "FIME · UANL",
    dates: "feb 2023 – mar 2024",
    body: "Seguimiento de procesos bajo ISO 9001 e ISO 21001, participación como auditor interno y una herramienta web de apoyo al área.",
  },
  {
    role: "Técnico Radiólogo",
    org: "Clínica y Laboratorio Teresita",
    body: "Radiografía convencional y apoyo en mamografía. Manejo del flujo de captura, procesamiento y entrega de los estudios digitales a pacientes y médicos.",
  },
];

type Link = { label: string; href: string };

const rfid = {
  name: "Sistema de control de acceso vehicular RFID",
  org: "FIME · UANL",
  status: "Software concluido · Integración con hardware pendiente",
  body: "Control de entradas y salidas por tarjeta RFID para un estacionamiento institucional. Levanté los requerimientos, diseñé una arquitectura híbrida offline/online para que siguiera operando sin conexión, y desarrollé todo el software: API REST en .NET, un servicio local (Gateway con .NET Worker Service y SQLite) que sincroniza al recuperar la red, un dashboard de administración en React y la base de datos en SQL Server con diagrama entidad-relación, diccionario de datos y permisos por rol. Documentado con casos de prueba, diagramas de arquitectura y manual funcional.",
  note: "El desarrollo de software está concluido. La integración con el hardware físico (lector RFID y pluma vehicular) quedó pendiente de despliegue.",
  // Añade el repo (aunque sea privado con README público) y/o el PDF de arquitectura:
  links: [] as Link[],
};

const stack = {
  desarrollo: ["C#", ".NET", "ASP.NET", "JavaScript", "React", "SQL Server"],
  proceso: ["Git", "Docker", "Linux", "BPMN", "AS-IS / TO-BE", "casos de prueba"],
  salud: ["HIS", "RIS", "LIS", "PACS", "DICOM", "HL7"],
};

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Francisco Delgado — Desarrollo de software · Sistemas de información en salud</title>
    <meta
      name="description"
      content="Francisco Delgado, ingeniero en Tecnología de Software (.NET, SQL Server) con formación técnica en radiología y experiencia hospitalaria. Se mueve hacia Health IT: sistemas de información clínica e imagenología."
    />
    <link rel="canonical" href="https://franciscodelgado.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Francisco Delgado — Desarrollo de software · Sistemas de información en salud" />
    <meta
      property="og:description"
      content="Ingeniero en Tecnología de Software con formación técnica en radiología. Desarrollo empresarial .NET/SQL Server y flujo clínico de imágenes."
    />
    <meta property="og:url" content="https://franciscodelgado.dev/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <header class="hero">
        <p class="hero__meta">Monterrey, Nuevo León</p>
        <h1>Francisco Delgado</h1>
        <p class="hero__lede">
          Desarrollador de software con formación técnica en radiología.
        </p>
        <p class="hero__body">
          Desarrollo aplicaciones internas en .NET y SQL Server en la Fiscalía
          General de Justicia de Nuevo León; antes, en Panasonic Energy México.
          Antes de programar trabajé como técnico radiólogo. Con esas dos bases
          me estoy moviendo hacia Health IT: sistemas de información clínica e
          imagenología.
        </p>
      </header>

      <section aria-labelledby="sobre-mi">
        <h2 id="sobre-mi">Sobre mí</h2>
        <p>
          Soy ingeniero en Tecnología de Software por la FIME-UANL. Trabajo en
          desarrollo full stack —C#, .NET, JavaScript, SQL Server— construyendo y
          manteniendo aplicaciones de uso interno: hoy una plataforma de gestión
          de proyectos y control de calidad en la Fiscalía; antes, soluciones
          para Recursos Humanos, Calidad, Producción y Finanzas en Panasonic
          Energy México.
        </p>
        <p>
          Buena parte de ese trabajo no es solo código: es levantar
          requerimientos con las áreas operativas, documentar el proceso
          (AS-IS/TO-BE, BPMN) y probar antes de liberar. Traduzco lo que necesita
          quien va a usar el sistema.
        </p>
        <p>
          Antes de programar tuve formación técnica en radiología y trabajé en
          una clínica: radiografía convencional, apoyo en mamografía y el manejo
          del flujo de captura, procesamiento y entrega de los estudios
          digitales. Health IT junta esas dos experiencias —el desarrollo
          empresarial que ya hago y el flujo clínico que ya viví— y es la
          dirección hacia la que estoy llevando mi trabajo.
        </p>
      </section>

      <section aria-labelledby="experiencia">
        <h2 id="experiencia">Experiencia</h2>
        <ol class="exp">
          {
            experience.map((j) => (
              <li class="exp__item">
                <div class="exp__head">
                  <h3 class="exp__role">
                    {j.role}
                    <span class="exp__org"> — {j.org}</span>
                  </h3>
                  {j.dates && <span class="exp__dates">{j.dates}</span>}
                </div>
                <p class="exp__body">{j.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="proyectos">
        <h2 id="proyectos">Proyectos</h2>
        <div class="project">
          <h3 class="project__name">
            {rfid.name}
            <span class="project__org"> — {rfid.org}</span>
          </h3>
          <p class="status status--done">{rfid.status}</p>
          <p class="project__body">{rfid.body}</p>
          <p class="project__note">{rfid.note}</p>
          {
            rfid.links.length > 0 && (
              <p class="project__links">
                {rfid.links.map((l) => (
                  <a href={l.href}>{l.label}</a>
                ))}
              </p>
            )
          }
        </div>
        <div class="project">
          <h3 class="project__name">Imagenología web</h3>
          <p class="status status--planning">En diseño</p>
          <p class="project__body">
            Hacia donde apunto: un visor de estudios DICOM que funcione desde el
            navegador, sin instalar software propietario, y un flujo ligero para
            recibir y organizar los estudios de un equipo portátil de rayos X.
            Diseño en curso, sin implementación todavía.
          </p>
        </div>
      </section>

      <section aria-labelledby="stack">
        <h2 id="stack">Stack</h2>
        <div class="stack">
          <p class="stack__label">Desarrollo</p>
          <ul class="tags">
            {stack.desarrollo.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="stack">
          <p class="stack__label">Herramientas y proceso</p>
          <ul class="tags">
            {stack.proceso.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="stack">
          <p class="stack__label">Sistemas de información en salud</p>
          <ul class="tags">
            {stack.salud.map((t) => <li>{t}</li>)}
          </ul>
          <p class="stack__caveat">
            Fundamentos, más el flujo clínico de imágenes vivido como técnico
            radiólogo. Sin implementación en producción todavía.
          </p>
        </div>
      </section>

      <section aria-labelledby="contacto">
        <h2 id="contacto">Contacto</h2>
        <ul class="contact">
          <li>
            <span class="contact__key">Email</span>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </li>
          {
            contact.tel && (
              <li>
                <span class="contact__key">Teléfono</span>
                <a href={`tel:${contact.tel.replace(/\s+/g, "")}`}>{contact.tel}</a>
              </li>
            )
          }
          <li>
            <span class="contact__key">LinkedIn</span>
            <a href={contact.linkedin} rel="me noopener" target="_blank"
              >{contact.linkedin.replace("https://www.", "")}</a
            >
          </li>
          <li>
            <span class="contact__key">CV</span>
            <a href={contact.cv}>Descargar PDF</a>
          </li>
        </ul>
      </section>

      <footer>
        <p>Monterrey, Nuevo León · {year}</p>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #0b0f14;
    --surface: #1c232b;
    --border: #2a333d;
    --text: #e8ecef;
    --text-dim: #9aa6af;
    --accent: #7fb3a8;
    --amber: #cc9a4a;

    --measure: 62ch;
    --font-sans: "IBM Plex Sans", ui-sans-serif, system-ui, -apple-system,
      "Segoe UI", Roboto, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, "SF Mono", "Menlo", "Consolas",
      monospace;
  }

  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  :global(html) {
    background: var(--bg);
    -webkit-text-size-adjust: 100%;
  }

  :global(body) {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-wrap: break-word;
  }

  main {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5.5rem) clamp(1.25rem, 5vw, 3rem) 4rem;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  p {
    max-width: var(--measure);
  }

  a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    padding-bottom: 1px;
  }

  a:hover {
    border-bottom-color: var(--accent);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 1px;
  }

  /* Hero — el único elemento con protagonismo visual */
  .hero {
    margin-bottom: 4.5rem;
  }

  .hero__meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0 0 1.25rem;
    letter-spacing: 0.02em;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    margin: 0 0 1.25rem;
  }

  .hero__lede {
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    color: var(--text);
    margin: 0 0 1.5rem;
    max-width: 34ch;
  }

  .hero__body {
    color: var(--text-dim);
    margin: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero > * {
      animation: rise 0.6s cubic-bezier(0.2, 0.6, 0.2, 1) both;
    }
    .hero h1 {
      animation-delay: 0.05s;
    }
    .hero__lede {
      animation-delay: 0.1s;
    }
    .hero__body {
      animation-delay: 0.15s;
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(0.5rem);
      }
    }
  }

  section {
    margin-bottom: 4rem;
  }

  h2 {
    font-size: 1.05rem;
    color: var(--text-dim);
    margin: 0 0 1.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  section > p {
    color: var(--text-dim);
    margin: 0 0 1.1rem;
  }

  /* Experiencia */
  .exp {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .exp__item {
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  .exp__item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .exp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
  }

  .exp__role {
    font-size: 1.05rem;
    margin: 0;
  }

  .exp__org {
    color: var(--text-dim);
    font-weight: 400;
  }

  .exp__dates {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .exp__body {
    margin: 0;
    color: var(--text-dim);
  }

  /* Proyectos — no tarjetas idénticas, separación por línea */
  .project {
    padding: 1.75rem 0;
    border-top: 1px solid var(--border);
  }

  .project:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .project__name {
    font-size: 1.15rem;
    margin: 0 0 0.6rem;
  }

  .project__org {
    color: var(--text-dim);
    font-weight: 400;
  }

  .status {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    margin: 0 0 0.9rem;
  }

  .status--done {
    color: var(--accent);
  }

  .status--planning {
    color: var(--amber);
  }

  .project__body {
    margin: 0;
    color: var(--text);
  }

  .project__note {
    margin: 0.9rem 0 0;
    padding-left: 0.9rem;
    border-left: 2px solid var(--border);
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .project__links {
    margin: 1rem 0 0;
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  /* Stack */
  .stack {
    margin-bottom: 1.75rem;
  }

  .stack__label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0 0 0.75rem;
    letter-spacing: 0.02em;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .stack__caveat {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  /* Contacto */
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact li {
    display: flex;
    gap: 1.25rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
  }

  .contact li:first-child {
    border-top: 0;
  }

  .contact__key {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    flex: 0 0 5.5rem;
    padding-top: 0.15rem;
  }

  .contact a {
    overflow-wrap: anywhere;
  }

  footer {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  footer p {
    margin: 0;
  }

  @media (max-width: 30rem) {
    .contact li {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
